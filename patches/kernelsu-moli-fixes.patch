+/* MoLi: 管理器加冕的内核侧重试。
+ * 本机开机早期 /data/app 的 FBE 密钥还不可见，签名校验返回 -ENOKEY，
+ * track_throne() 一次就失败 → 管理器显示"未安装"。
+ * 这里用延时工作队列在 FBE 解锁后重试若干次，不依赖任何用户态模块。
+ */
+static void moli_crown_work(struct work_struct *w);
+static DECLARE_DELAYED_WORK(moli_crown_wq, moli_crown_work);
+static int moli_crown_tries;
+
+static void moli_crown_work(struct work_struct *w)
+{
+    moli_crown_tries++;
+
+    if (ksu_is_manager_appid_valid()) {
+        pr_err("MoLi crown: manager already valid (try %d)\n", moli_crown_tries);
+        return;
+    }
+
+    pr_err("MoLi crown: try %d\n", moli_crown_tries);
+    track_throne(false);
+
+    if (!ksu_is_manager_appid_valid() && moli_crown_tries < 10)
+        schedule_delayed_work(&moli_crown_wq, 3 * HZ);
+    else
+        pr_err("MoLi crown: done, valid=%d tries=%d\n",
+               ksu_is_manager_appid_valid(), moli_crown_tries);
+}
+
 void on_boot_completed(void)
 {
     ksu_boot_completed = true;
     pr_info("on_boot_completed!\n");
+
+    /* MoLi: 开机早期（post-fs-data）内核上下文读 FBE 加密的 /data 会返回 -ENOKEY，
+     * 那时加载 allowlist / 校验管理器 APK 都会失败（实测 is_manager: 0）。
+     * 到 boot_completed 时 FBE 已解锁、/data 可正常读，这里再加载一次。
+     */
+    ksu_load_allow_list();
     // MoLi: 开机完成时做一次完整的管理器扫描（track_throne(false)）。
     // 上游此处传的 prune_only=true 会直接 goto prune，跳过管理器识别；
     // 而识别原本只依赖 packages.list 的 create/move 事件，在部分 ROM（本机 NOH-AN01）
     // 开机时并不触发，导致管理器不被"加冕"、UI 显示"未安装"。
     // 此处改为完整扫描：开机完成时 /data/system/packages.list 必然已就绪，识别是确定性的。
     track_throne(false);
+    /* MoLi: 立刻这次很可能仍 -ENOKEY，再排一个延时重试序列 */
+    schedule_delayed_work(&moli_crown_wq, 3 * HZ);
     ksu_selinux_hide_drop_backup_if_unused();
 }
