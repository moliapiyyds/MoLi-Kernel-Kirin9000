+/* MoLi: 若从未成功加载过 allowlist，再试一次。
+ * 由 su 请求路径调用；此时调用者已是用户态进程，可读 /data。
+ * 用计数器限制重试次数，避免文件真不存在时反复 filp_open。
+ */
+void ksu_allowlist_try_reload(void)
+{
+    static atomic_t retry = ATOMIC_INIT(0);
+
+    if (allowlist_loaded_ok)
+        return;
+    if (atomic_read(&retry) >= 8)
+        return;
+    atomic_inc(&retry);
+
+    pr_info("MoLi: allowlist retry load #%d\n", atomic_read(&retry));
+    ksu_load_allow_list();
+}
