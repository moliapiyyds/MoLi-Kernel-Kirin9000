+/* MoLi: 主路径用 /data/adb —— 不再依赖任何用户态模块去挂 /metadata。
+ * 内核写 FBE 加密的 /data 原本会 -ENOKEY(-126)，原因见 moli_fbe_creds()：
+ * override_creds(ksu_cred) 把 session keyring 也换掉了，FBE 密钥丢了。
+ * 现在保存/加载都用「保留 keyring、只提权 uid/caps」的 cred，所以能直接写 /data。
+ * /metadata/ksu/.allowlist 保留为回退（老用户的文件在那儿）。
+ */
+#define KERNEL_SU_ALLOWLIST "/data/adb/ksu/.allowlist"
+#define KERNEL_SU_ALLOWLIST_LEGACY "/metadata/ksu/.allowlist"
+
+/* MoLi: 是否成功加载过一次。为 false 时，su 请求路径会再尝试加载
+ * （那时是用户态进程上下文，能读 FBE 加密的 /data）。
+ */
+static bool allowlist_loaded_ok __read_mostly;
+
 
 void ksu_persistent_allow_list(void);
 
+/* MoLi: FBE 修复 —— 内核上下文写 FBE 加密的 /data 会返回 -ENOKEY，
+ * 因为 override_creds(ksu_cred) 连 session keyring 一起换掉了，
+ * 而 fscrypt 的解密密钥就挂在 keyring 上。
+ * 这里克隆“调用者自己”的 cred（保留 keyring），只把 uid/gid/caps 提到 root。
+ * 返回 NULL 表示失败，调用方应回退到 ksu_cred。
+ */
+static const struct cred *moli_fbe_creds(void)
+{
+    struct cred *new;
+
+    new = prepare_creds();
+    if (!new)
+        return NULL;
+
+    new->uid = new->euid = new->suid = new->fsuid = GLOBAL_ROOT_UID;
+    new->gid = new->egid = new->sgid = new->fsgid = GLOBAL_ROOT_GID;
+
+    /* 直接抄 ksu_cred 的 cap 集合，避免依赖 cap_set_full 宏 */
+    new->cap_inheritable = ksu_cred->cap_inheritable;
+    new->cap_permitted = ksu_cred->cap_permitted;
+    new->cap_effective = ksu_cred->cap_effective;
+    new->cap_bset = ksu_cred->cap_bset;
+    new->cap_ambient = ksu_cred->cap_ambient;
+
+    return new;
+}
